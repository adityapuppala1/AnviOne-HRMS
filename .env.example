NODE_ENV=development
AUTH_MODE=demo
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# pnpm setup:local generates random local-only passwords and writes .env.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
WORKER_DB_PASSWORD=
IDENTITY_OPERATOR_DB_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_URL=
WORKER_DATABASE_URL=
# Operations-only credential. Do not inject it into the API or worker runtime.
IDENTITY_OPERATOR_DATABASE_URL=
CANDIDATE_DB_PASSWORD=
CANDIDATE_DATABASE_URL=
# Synthetic-only encrypted delivery preview; never a production mail fallback.
ONBOARDING_PREVIEW_KEY=
CANDIDATE_ORIGIN=http://127.0.0.2:5174
# OIDC mode requires a tenant-specific HTTPS issuer and exact registered callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_REQUIRED_ACR=
# Behind a load balancer: proxy hop count (1-5) or proxy IPs/CIDRs. Leave empty locally.
TRUST_PROXY=
# Shared rate-limit counters. pnpm setup:local fills these for the local Valkey;
# production requires rediss:// so every replica shares one budget over TLS.
VALKEY_PASSWORD=
RATE_LIMIT_URL=

# Personal details encryption (production requires one of these). PROFILE_DATA_KEYS is a comma list of id:64-hex-chars, newest first, ids 1-255.
# Keep retired keys listed while immutable history still uses them; rotate with `pnpm profile:rekey`.
# PROFILE_DATA_KEYS=
# PROFILE_DATA_KEY=
# Worker: how often to apply approved, now-due profile changes (milliseconds; 0 disables; default one hour).
# PROFILE_APPLY_DUE_INTERVAL_MS=3600000
