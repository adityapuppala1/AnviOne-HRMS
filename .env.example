NODE_ENV=development
AUTH_MODE=demo
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# pnpm setup:local generates random local-only passwords and writes .env.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
WORKER_DB_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_URL=
WORKER_DATABASE_URL=
# OIDC mode requires a tenant-specific HTTPS issuer and exact registered callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_REQUIRED_ACR=
